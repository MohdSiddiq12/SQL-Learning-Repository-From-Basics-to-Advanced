7. Advanced SQL Techniques
Task 19: Find the longest song for each band
sqlSELECT b.name AS band_name, s.name AS song_name, s.length AS song_length
FROM bands b
JOIN albums a ON b.id = a.band_id
JOIN songs s ON a.id = s.album_id
WHERE (b.id, s.length) IN (
    SELECT b.id, MAX(s.length)
    FROM bands b
    JOIN albums a ON b.id = a.band_id
    JOIN songs s ON a.id = s.album_id
    GROUP BY b.id
);
