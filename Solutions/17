Task 17: Find albums that have songs longer than 8 minutes
sqlSELECT DISTINCT a.name AS album_name, b.name AS band_name
FROM albums a
JOIN bands b ON a.band_id = b.id
JOIN songs s ON a.id = s.album_id
WHERE s.length > 8;
