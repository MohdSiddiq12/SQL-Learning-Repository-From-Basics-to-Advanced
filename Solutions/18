Task 18: Find bands that have more than 10 songs
sqlSELECT b.name AS band_name, COUNT(s.id) AS song_count
FROM bands b
JOIN albums a ON b.id = a.band_id
JOIN songs s ON a.id = s.album_id
GROUP BY b.id, b.name
HAVING COUNT(s.id) > 10;
