Task 9: List all songs with their album and band names
sql
SELECT s.name AS song_name, s.length AS song_length,
       a.name AS album_name, b.name AS band_name
FROM songs s
JOIN albums a ON s.album_id = a.id
JOIN bands b ON a.band_id = b.id;

